<Window x:Class="Tide.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tide"
        Title="Tide" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <!-- The same groups, rows, labels and notes as the Display pane of the macOS app. -->
    <Window.Resources>
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,6,4,20"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,20,20,20">
        <Border Style="{StaticResource Group}">
            <DockPanel Style="{StaticResource Row}">
                <CheckBox x:Name="EnabledBox" DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="0" Padding="0"/>
                <TextBlock Text="Dim Display When Idle" Style="{StaticResource Label}"/>
            </DockPanel>
        </Border>
        <TextBlock Style="{StaticResource Note}"
                   Text="Fades the display after a period of inactivity and restores it when you return. Skipped during video and calls."/>

        <StackPanel x:Name="Timing">
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <local:NumberField x:Name="AfterField" Minimum="5" Maximum="3600" Step="15"/>
                            <TextBlock Text="seconds" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="Dim After" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Slider x:Name="LevelSlider" Width="200" VerticalAlignment="Center"
                                    Minimum="5" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="None"/>
                            <TextBlock x:Name="LevelText" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="Dimmed Brightness" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <local:NumberField x:Name="FadeOutField" Minimum="0" Maximum="10" Step="0.1" Decimals="2"/>
                            <TextBlock Text="seconds" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="Fade Out" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <local:NumberField x:Name="FadeInField" Minimum="0" Maximum="10" Step="0.1" Decimals="2"/>
                            <TextBlock Text="seconds" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="Fade In" Style="{StaticResource Label}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Note}"
                       Text="Dimmed brightness is relative to the brightness before dimming. The pointer is hidden while dimmed."/>
        </StackPanel>

        <Border Style="{StaticResource Group}">
            <DockPanel Style="{StaticResource Row}">
                <Button x:Name="ResetButton" DockPanel.Dock="Right" Content="Reset to Defaults" VerticalAlignment="Center"/>
                <Button x:Name="PreviewButton" HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="140"/>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
